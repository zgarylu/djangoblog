{% extends "layout.html" %} {% block title %} Sign In {% endblock %}
{% block content %}

<style>
    .login-box {
        max-width: 460px;
        margin: 70px auto;
        padding: 45px;
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .login-box h1 {
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 10px;
    }

    .login-box p {
        text-align: center;
        color: #6c757d;
        margin-bottom: 30px;
    }

    .login-box input {
        margin-bottom: 18px;
    }

    .btn-login {
        width: 100%;
        padding: 12px;
        font-weight: 600;
        border-radius: 10px;
    }

    .footer-link {
        text-align: center;
        margin-top: 25px;
    }

    .footer-link a {
        text-decoration: none;
    }

    .footer-link a:hover {
        text-decoration: underline;
    }

    .login-box .form-control {
        height: 50px;
        border-radius: 10px;
        border: 1px solid #ced4da;
    }

    .login-box .form-control:focus {
        box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .15);
        border-color: #0d6efd;
    }

    .login-box .btn {
        height: 50px;
        border-radius: 10px;
        font-weight: 600;
    }
</style>

<div class="login-box">
    <h1>Sign In</h1>

    <p>Sign in to continue to your account.</p>

    <form method="post">
        {% csrf_token %}

        <div class="mb-4">
            <label for="{{ form.login.id_for_label }}" class="form-label fw-semibold">Username or Email</label>

            <input type="text" name="{{ form.login.name }}" id="{{ form.login.id_for_label }}"
                value="{{ form.login.value|default:'' }}" class="form-control form-control-lg"
                placeholder="Enter your username or email" />

            {% if form.login.errors %}
            <div class="text-danger small mt-1">{{ form.login.errors }}</div>
            {% endif %}
        </div>

        <div class="mb-4">
            <label for="{{ form.password.id_for_label }}" class="form-label fw-semibold">Password</label>

            <input type="password" name="{{ form.password.name }}" id="{{ form.password.id_for_label }}"
                class="form-control form-control-lg" placeholder="Enter your password" />

            {% if form.password.errors %}
            <div class="text-danger small mt-1">{{ form.password.errors }}</div>
            {% endif %}
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="remember" />

                <label class="form-check-label" for="remember"> Remember me </label>
            </div>

            <a href="{% url 'account_reset_password' %}" class="text-decoration-none">Forgot password?</a>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">Sign In</button>
    </form>

    <div class="footer-link">Don't have an account?<a href="{% url 'account_signup' %}"> Create one </a></div>
</div>

{% endblock %}